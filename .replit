modules = ["nodejs-20", "python-3.12", "web", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "数据库每日备份"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow]]
name = "数据库每日备份"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts exec tsx ./src/backup-scheduler.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3000 RESEND_API_KEY=${RESEND_API_KEY:-re_dev_placeholder} pnpm --filter @workspace/api-server run dev"
waitForPort = 3000

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
PAYMENT_APP_ID = "P5D95AW5HOZFDVH1672QIODY0GZCDDCP"
PRIVATE_OBJECT_DIR = "/replit-objstore-c1949c7c-efeb-4e1f-9eef-4ef3e64d9013/.private"
PUBLIC_OBJECT_SEARCH_PATHS = "/replit-objstore-c1949c7c-efeb-4e1f-9eef-4ef3e64d9013/public"

[userenv.production]
APP_BASE_URL = "https://www.opcorder.com"

[objectStorage]
defaultBucketID = "replit-objstore-c1949c7c-efeb-4e1f-9eef-4ef3e64d9013"

[[ports]]
localPort = 8080
externalPort = 8080
